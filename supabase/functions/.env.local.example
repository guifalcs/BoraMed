# Secrets das edge functions para TESTE — copie para `.env.local` (gitignored) e
# preencha com as credenciais de TESTE do Mercado Pago.
#   cp .env.local.example .env.local
#
# Use com o stack local:
#   supabase functions serve --env-file ./supabase/functions/.env.local
#
# NUNCA comite o .env.local nem cole esses valores no chat.

# --- Mercado Pago (vendedor de TESTE) ---
# Access Token de teste do seu vendedor de teste (começa com TEST-...).
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxx
# Secret da assinatura do webhook (Painel MP test → Webhooks → sua integração).
MP_WEBHOOK_SECRET=defina_o_secret_do_webhook_de_teste

# --- App ---
# Para receber o retorno do MP localmente: use a URL pública do túnel (ngrok) que
# aponta para o app local. Se ficar em http://localhost, o checkout cai no
# redirecionador mp-retorno (que precisa de APP_URL https para devolver ao app).
APP_URL=http://localhost:4200
# Origens permitidas no CORS das functions (separadas por vírgula).
APP_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Correção de questões abertas por IA (corrigir-resposta-aberta) ---
# Provider: 'openai-compat' (OpenRouter/OpenAI/Gemini via chat completions) ou
# 'fake' (determinístico, sem rede — dev local e e2e). Ausente/vazio = sem IA:
# as correções viram `sem_ia` e a questão sai do denominador da nota.
AI_GRADING_PROVIDER=fake
# Só usados quando AI_GRADING_PROVIDER=openai-compat:
# OpenRouter: https://openrouter.ai/api/v1 | OpenAI: https://api.openai.com/v1
AI_GRADING_BASE_URL=https://openrouter.ai/api/v1
AI_GRADING_MODEL=deepseek/deepseek-v4-flash
AI_GRADING_API_KEY=sk-or-xxxxxxxxxxxxxxxx
# (Só OpenRouter) Ordem de roteamento de provider, separada por vírgula. O 1º tem
# prioridade e os demais viram fallback (allow_fallbacks=true). Fixar um provider
# mantém o prompt caching quente (cache é por-provider). Vazio = OpenRouter decide.
AI_GRADING_ROUTER_ORDER=gmicloud,baidu,deepinfra,digitalocean,streamlake
# Máximo de correções por usuário por dia (default 200).
AI_GRADING_DAILY_LIMIT=200

# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY são injetadas
# automaticamente pelo `supabase functions serve` no stack local — não precisa
# definir aqui.
