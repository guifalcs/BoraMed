tests/e2e/fixtures/.auth.json
.env

# Secrets de teste das edge functions (manter apenas os *.example versionados)
supabase/functions/.env
supabase/functions/.env.*
!supabase/functions/.env.*.example

# node_modules gerado pelo Deno (nodeModulesDir: auto) — recriado via deno.lock
supabase/functions/node_modules/
.tools/
# sessão/credenciais do vendedor de teste MP (scripts mp-seller-* / vendedor-login)
scripts/teste-manual-mp/session.json
scripts/teste-manual-mp/mp-seller-state.json
scripts/teste-manual-mp/creds*.json
scripts/teste-manual-mp/*.png

# node_modules na raiz (cache do Deno)
/node_modules/

# Dumps do banco (nunca commitar)
supabase/backups/*.sql
supabase/backups/*.dump

# Ignora TUDO em backups (dumps sensíveis)
supabase/backups/**
!supabase/backups/README.md

# Diretório de trabalho da importação de provas digitalizadas: contém os scans
# da prova, transcrições e o markdown gerado. Material de prova + dados de
# aluno nas fotos — nunca versionar.
scripts/importar-prova-scan/.trabalho/
# Idem para o pipeline do relatório de devolutiva (Integradora, SOI, HAM): o
# relatório traz nome do aluno no cabeçalho, além do conteúdo da prova.
scripts/importar-prova-devolutiva/.trabalho/
# PDFs de prova soltos na raiz ou em pasta de lote (entrada do pipeline)
/*.pdf
/provas*/
/HAM */
/IESC */
/SOI */
/CC */
/CI */
# Pastas de lote por período (ex: "6 periodo/CC 2/...") — mesmos PDFs com nome
# de aluno no cabeçalho, só organizados um nível mais fundo.
/*periodo/
# revisao humana baixada pelo navegador, se salva fora do diretorio de trabalho
/questoes-revisadas*.json
